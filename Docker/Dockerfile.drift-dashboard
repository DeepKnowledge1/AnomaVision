FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir "gradio>=6.3.0"

COPY apps/ui/drift_dashboard.py ./apps/ui/drift_dashboard.py

EXPOSE 7861

CMD ["python", "apps/ui/drift_dashboard.py"]

