FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir "gradio>=6.3.0" pyyaml

COPY anomavision/drift_dashboard.py ./anomavision/drift_dashboard.py
COPY anomavision/config.py ./anomavision/config.py
COPY apps/ui/drift_dashboard.py ./apps/ui/drift_dashboard.py

EXPOSE 7860

CMD ["python", "apps/ui/drift_dashboard.py"]

